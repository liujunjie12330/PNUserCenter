<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pn.dao.mapper.PnColumnInfoMapper">
    <resultMap id="BaseResultMap" type="com.pn.dao.entity.PnColumnInfo">
        <!--@mbg.generated-->
        <!--@Table pn_column_info-->
        <id column="id" jdbcType="BIGINT" property="id"/>
        <result column="create_at" jdbcType="TIMESTAMP" property="createAt"/>
        <result column="update_at" jdbcType="TIMESTAMP" property="updateAt"/>
        <result column="create_by" jdbcType="BIGINT" property="createBy"/>
        <result column="update_by" jdbcType="BIGINT" property="updateBy"/>
        <result column="is_deleted" jdbcType="INTEGER" property="isDeleted"/>
        <result column="column_name" jdbcType="VARCHAR" property="columnName"/>
        <result column="user_id" jdbcType="BIGINT" property="userId"/>
        <result column="introduction" jdbcType="VARCHAR" property="introduction"/>
        <result column="cover" jdbcType="VARCHAR" property="cover"/>
        <result column="state" jdbcType="INTEGER" property="state"/>
        <result column="publish_time" jdbcType="TIMESTAMP" property="publishTime"/>
        <result column="section" jdbcType="INTEGER" property="section"/>
        <result column="nums" jdbcType="INTEGER" property="nums"/>
        <result column="type" jdbcType="INTEGER" property="type"/>
        <result column="free_start_time" jdbcType="TIMESTAMP" property="freeStartTime"/>
        <result column="free_end_time" jdbcType="TIMESTAMP" property="freeEndTime"/>
    </resultMap>
    <sql id="Base_Column_List">
        <!--@mbg.generated-->
        id,
        create_at,
        update_at,
        create_by,
        update_by,
        is_deleted,
        `column_name`,
        user_id,
        introduction,
        cover,
        `state`,
        publish_time,
        `section`,
        nums,
        `type`,
        free_start_time,
        free_end_time
    </sql>

    <select id="getByArticleId" resultMap="BaseResultMap">
        select column_info.id,
               column_info.create_at,
               column_info.update_at,
               column_info.create_by,
               column_info.update_by,
               column_info.is_deleted,
               column_info.column_name,
               column_info.user_id,
               column_info.introduction,
               column_info.cover,
               column_info.state,
               column_info.publish_time,
               column_info.section,
               column_info.nums,
               column_info.type,
               column_info.free_start_time,
               column_info.free_end_time
        from pn_column_info as `column_info`
                 left join pn_column_article as column_article
                           on column_info.id = column_article.column_id
        where column_info.is_deleted = 0
          and column_article.article_id = #{articleId}
    </select>
</mapper>